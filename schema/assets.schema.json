{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/assets.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "assets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "lines",
          "standIn",
          "priority",
          "note"
        ],
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "standIn": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
