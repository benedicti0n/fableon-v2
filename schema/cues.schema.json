{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/cues.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "music", "stingers", "sfx"],
  "properties": {
    "version": { "const": 1 },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "music": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene", "mood", "tempo", "intensity", "instruments"],
        "properties": {
          "scene": { "type": "string", "minLength": 1 },
          "mood": { "enum": ["calm", "warm", "tense", "dark", "wonder", "triumph"] },
          "tempo": { "type": "number", "minimum": 40, "maximum": 180 },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "instruments": { "type": "array", "minItems": 1, "items": { "enum": ["tanpura", "sitar", "flute", "tabla", "musicbox", "pad", "glock", "timpani"] } }
        }
      }
    },
    "stingers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "at"],
        "properties": {
          "kind": { "enum": ["hook", "mystery", "payoff"] },
          "at": { "type": "string", "pattern": "^(?:[0-9]+:[0-9]+|f[0-9]+)$" }
        }
      }
    },
    "sfx": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "at"],
        "properties": {
          "kind": { "enum": ["poof", "shimmer", "thud", "whoosh", "flashHit", "pop", "arrow", "steps"] },
          "at": { "type": "string", "pattern": "^(?:[0-9]+:[0-9]+|f[0-9]+)$" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
