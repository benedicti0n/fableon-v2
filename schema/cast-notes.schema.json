{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/cast-notes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "notes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ts",
          "text"
        ],
        "properties": {
          "ts": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
