{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/script.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "seconds", "wps", "characters", "names", "lines"],
  "properties": {
    "version": { "enum": [1, 2] },
    "title": { "type": "string", "minLength": 1 },
    "seconds": { "type": "number", "exclusiveMinimum": 5 },
    "wps": { "type": "number", "exclusiveMinimum": 0 },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "look"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "look": { "type": "string" }
        }
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "names": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["word", "phonemes", "suggested"],
        "properties": {
          "word": { "type": "string", "minLength": 1 },
          "phonemes": { "type": ["string", "null"] },
          "suggested": { "type": "boolean" }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "text", "beat", "facts", "look"],
        "properties": {
          "n": { "type": "integer", "minimum": 0 },
          "text": { "type": "string", "minLength": 1 },
          "gloss": { "type": "string", "minLength": 1 },
          "beat": { "enum": ["hook", "setting", "action", "snap", "deadpan", "explain", "consequence", "twist"] },
          "facts": { "type": "array", "items": { "type": "string", "pattern": "^F[0-9]+$" } },
          "look": {
            "type": "object",
            "additionalProperties": false,
            "required": ["set", "who", "note"],
            "properties": {
              "set": { "type": "string" },
              "mark": { "type": ["string", "null"] },
              "who": { "type": "array", "items": { "type": "string" } },
              "pose": { "type": ["string", "null"] },
              "expr": { "type": ["string", "null"] },
              "prop": { "type": ["string", "null"] },
              "note": { "type": "string" }
            }
          },
          "delivery": { "$ref": "#/$defs/delivery" }
        }
      }
    }
  },
  "$defs": {
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": { "enum": ["deadpan", "mock-serious", "matter-of-fact", "warm", "excited", "tense", "awe", "whisper"] },
        "pauseBefore": { "type": "number", "minimum": 0, "maximum": 1.2 },
        "pauses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after", "s"],
            "properties": {
              "after": { "type": "string", "minLength": 1 },
              "s": { "type": "number", "minimum": 0.15, "maximum": 1 }
            }
          }
        },
        "emphasis": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
