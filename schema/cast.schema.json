{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/cast.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "characters"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "mustHave",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "spec": {
            "$ref": "#/$defs/Spec"
          },
          "cast": {
            "type": "string",
            "minLength": 1
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "mustHave": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "required": [
              "spec"
            ]
          },
          {
            "required": [
              "cast"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "Spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skin"
      ],
      "properties": {
        "skin": {
          "type": "string"
        },
        "build": {
          "enum": [
            "adult",
            "stout",
            "kid",
            "big",
            "elder",
            "slim",
            "baby"
          ]
        },
        "top": {
          "type": [
            "string",
            "null"
          ]
        },
        "lower": {
          "type": "string"
        },
        "sari": {
          "type": [
            "string",
            "null"
          ]
        },
        "border": {
          "type": "string"
        },
        "drape": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "enum": [
            "crown",
            "crownSmall",
            "turban",
            "bun",
            "hair",
            "long",
            "bald",
            "topknot",
            "helmet",
            "jata",
            "loose",
            "featherCrown",
            null
          ]
        },
        "hairCol": {
          "type": "string"
        },
        "crownCol": {
          "type": "string"
        },
        "turbanCol": {
          "type": "string"
        },
        "beard": {
          "type": [
            "string",
            "null"
          ]
        },
        "beardLong": {
          "type": "boolean"
        },
        "moustache": {
          "type": [
            "string",
            "null"
          ]
        },
        "necklace": {
          "type": [
            "string",
            "null"
          ]
        },
        "tilak": {
          "type": [
            "string",
            "null"
          ]
        },
        "blindfold": {
          "type": [
            "string",
            "null"
          ]
        },
        "blind": {
          "type": "boolean"
        },
        "flower": {
          "type": [
            "string",
            "null"
          ]
        },
        "belly": {
          "type": "number"
        },
        "earrings": {
          "type": [
            "string",
            "null"
          ]
        },
        "armour": {
          "type": [
            "string",
            "null"
          ]
        },
        "kavacha": {
          "type": "boolean"
        },
        "quiver": {
          "type": [
            "string",
            "null"
          ]
        },
        "gem": {
          "type": [
            "string",
            "null"
          ]
        },
        "snake": {
          "type": [
            "string",
            "null"
          ]
        },
        "crescent": {
          "type": [
            "string",
            "null"
          ]
        },
        "armlets": {
          "type": [
            "string",
            "null"
          ]
        },
        "ash": {
          "type": [
            "string",
            "null"
          ]
        },
        "lowerPattern": {
          "enum": [
            "plain",
            "tiger",
            "bark"
          ]
        },
        "emblem": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
