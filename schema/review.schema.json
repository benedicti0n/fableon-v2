{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lines"],
  "properties": {
    "version": { "const": 1 },
    "reviewedAt": { "type": "string" },
    "model": { "type": ["string", "null"] },
    "settings": { "type": "object" },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line", "verdict", "reason", "ts"],
        "properties": {
          "line": { "type": "integer", "minimum": 0 },
          "verdict": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 },
          "ts": { "type": "string" },
          "hash": { "type": ["string", "null"] }
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "verdict", "facts", "note", "fix"],
        "properties": {
          "n": { "type": "integer", "minimum": 0 },
          "verdict": { "enum": ["ok", "unsupported", "distorted", "opinion"] },
        "craft": { "enum": ["ok", "weak"] },
          "facts": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" },
          "fix": { "type": "string" },
          "hash": { "type": ["string", "null"] },
          "confirmed": { "type": "boolean" }
        }
      }
    }
  }
}
