{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/look.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scenes"],
  "properties": {
    "version": { "const": 1 },
    "scenes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mood": { "enum": ["golden-glow", "warm-side", "dusk", "night-moon", "noon"] },
          "exposure": { "type": "number", "minimum": -0.5, "maximum": 0.5 },
          "warmth": { "type": "number", "minimum": -1, "maximum": 1 },
          "glow": { "type": "number", "minimum": 0, "maximum": 1.5 },
          "haze": { "type": "number", "minimum": 0, "maximum": 1.5 },
          "shafts": { "enum": ["off", "soft", "strong"] },
          "vignette": { "type": "number", "minimum": 0, "maximum": 1.5 }
        }
      }
    }
  }
}
