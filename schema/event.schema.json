{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/event.schema.json",
  "title": "Fableon event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ts",
    "type"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "job",
        "stage",
        "progress",
        "log",
        "artifact",
        "status",
        "budget",
        "error"
      ]
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "job": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "op": {
      "type": [
        "string",
        "null"
      ]
    },
    "step": {
      "type": [
        "string",
        "null"
      ]
    },
    "done": {
      "type": [
        "number",
        "null"
      ]
    },
    "total": {
      "type": [
        "number",
        "null"
      ]
    },
    "etaMs": {
      "type": [
        "number",
        "null"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed",
        "cancelled",
        "interrupted",
        "fresh",
        "stale",
        "edited",
        "approved",
        "missing"
      ]
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "code": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
