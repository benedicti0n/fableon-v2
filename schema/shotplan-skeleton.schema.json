{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/shotplan-skeleton.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "shots"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lines",
          "start",
          "set",
          "light",
          "characters",
          "mustShow",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "start": {
            "$ref": "#/$defs/Anchor"
          },
          "set": {
            "type": "string",
            "minLength": 1
          },
          "light": {
            "type": "string",
            "minLength": 1
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mustShow": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "hold": {
            "type": "boolean"
          },
          "why": {
            "type": "string"
          },
          "lightChange": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "Anchor": {
      "type": "string",
      "pattern": "^(?:[0-9]+:[0-9]+)(?:[+-][0-9]+(?:\\.[0-9]+)?[fs])?$"
    }
  }
}
