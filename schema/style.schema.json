{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/style.schema.json",
  "title": "Fableon style pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "description", "status", "source", "formats", "adapter", "catalog", "boardSchema", "prompts", "qa", "cache"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ready", "porting", "not-ready"] },
    "testOnly": { "type": "boolean" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "licence"],
      "properties": {
        "skill": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "licence": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "formats": { "type": "array", "minItems": 1, "items": { "enum": ["short-vertical"] } },
    "sampleFrames": { "type": "array", "items": { "type": "string" } },
    "adapter": { "type": "string", "minLength": 1 },
    "catalog": { "type": "string", "minLength": 1 },
    "boardSchema": { "type": "string", "minLength": 1 },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["director", "craft"],
      "properties": {
        "director": { "type": "string", "minLength": 1 },
        "craft": { "type": "string", "minLength": 1 },
        "cards": { "type": "string" }
      }
    },
    "lookControls": {
      "type": "array",
      "items": { "enum": ["exposure", "warmth", "glow", "haze", "vignette", "shafts"] }
    },
    "craftFormula": { "enum": ["default", "custom"] },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sfxKinds": { "type": "array", "items": { "type": "string" } },
        "instruments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozenFrames", "popFactor", "popOffset"],
      "properties": {
        "frozenFrames": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "popFactor": { "type": "number", "minimum": 1 },
        "popOffset": { "type": "number", "minimum": 0 },
        "lookTargets": { "type": "object" }
      }
    },
    "cache": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" }
  }
}
