{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/facts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "facts"],
  "properties": {
    "version": { "const": 1 },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "kind", "sources", "confidence", "verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]+$" },
          "claim": { "type": "string", "minLength": 10 },
          "kind": { "enum": ["event", "person", "place", "number", "tradition"] },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "quote"],
              "properties": {
                "source": { "type": "string", "pattern": "^S[0-9]+$" },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          },
          "confidence": { "enum": ["high", "medium", "low"] },
          "verified": { "type": "boolean" }
        }
      }
    }
  }
}
