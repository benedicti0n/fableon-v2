{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableon.local/schema/pronunciations.schema.json",
  "type": "object",
  "additionalProperties": {
    "anyOf": [
      {
        "type": "string",
        "minLength": 1
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sayAs"
        ],
        "properties": {
          "sayAs": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    ]
  }
}
